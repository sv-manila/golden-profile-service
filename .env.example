# ---- Golden Profile Service configuration ----

# Database. Default is a local SQLite file so the service runs with zero setup.
# For production use MySQL / MariaDB (matches the CAMI schema types), e.g.:
#   DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/golden_profile
DATABASE_URL=sqlite:///./golden_profile.db

# API keys that CAMI must present in the `X-API-Key` header (comma separated).
# Change these before deploying. If empty, auth is DISABLED (dev only).
API_KEYS=dev-cami-key

# Credential-match statuses (case-insensitive) that count as a VALID cached
# result during a search. Comma separated.
VALID_MATCH_STATUSES=VALID,ACTIVE,CLEAR,PASS,VERIFIED

# Secret used to derive ssn_hash / tin_hash when CAMI sends a raw value but no
# hash. Keep this identical across environments that must produce matching hashes.
HASH_SECRET=change-me
